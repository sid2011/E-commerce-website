<section class="py-4">
  <div class="container">

    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h2 class="fw-bold mb-1">Your Shopping Cart</h2>
        <p class="text-muted small mb-0">Review your selected items and proceed to checkout</p>
      </div>

      <a href="/" class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Continue Shopping
      </a>
    </div>

    {{#if cartEmpty}}
      <div class="text-center py-5 bg-white rounded-4 border shadow-sm my-4">
        <div class="py-4">
          <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 80px; height: 80px;">
            <i class="bi bi-cart-x fs-1 text-muted"></i>
          </div>
          <h3 class="fw-bold">Your Cart is Currently Empty</h3>
          <p class="text-muted mb-4">Looks like you haven't added anything to your cart yet.</p>
          <a href="/" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
            <i class="bi bi-bag-plus me-1"></i> Explore Products
          </a>
        </div>
      </div>
    {{else}}

      <div class="row g-4">
        
        <!-- Cart Items List -->
        <div class="col-lg-8">
          <div class="modern-table-card">
            <div class="table-responsive">
              <table class="table modern-table">
                <thead>
                  <tr>
                    <th scope="col" style="width: 60px;">#</th>
                    <th scope="col" style="width: 80px;">Item</th>
                    <th scope="col">Product</th>
                    <th scope="col">Price</th>
                    <th scope="col" class="text-center">Quantity</th>
                    <th scope="col" class="text-end">Action</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each products}}
                  <tr>
                    <td class="fw-semibold text-muted">{{inc @index}}</td>
                    <td>
                      <img
                        src="/product-images/{{this.product._id}}.jpg"
                        alt="{{this.product.name}}"
                        class="rounded-3 border"
                        style="width: 54px; height: 54px; object-fit: contain; background: #fff;"
                        onerror="this.onerror=null; this.src='https://placehold.co/100x100/e2e8f0/475569?text=IMG';"
                      />
                    </td>
                    <td>
                      <div class="fw-bold text-dark">{{this.product.name}}</div>
                      <span class="badge bg-light text-primary border" style="font-size: 0.72rem;">{{this.product.category}}</span>
                    </td>
                    <td>
                      <span class="fw-bold text-dark">₹{{this.product.price}}</span>
                    </td>
                    <td class="text-center">
                      <div class="d-inline-flex align-items-center gap-2 border rounded-pill px-2 py-1 bg-light">
                        <button
                          type="button"
                          class="btn btn-sm btn-link text-dark p-0 border-0"
                          onclick="changeQuantity('{{this._id}}','{{this.product._id}}', -1)"
                        >
                          <i class="bi bi-dash-circle fs-5"></i>
                        </button>

                        <span id="{{this.product._id}}" class="fw-bold px-2">
                          {{this.quantity}}
                        </span>

                        <button
                          type="button"
                          class="btn btn-sm btn-link text-dark p-0 border-0"
                          onclick="changeQuantity('{{this._id}}','{{this.product._id}}', 1)"
                        >
                          <i class="bi bi-plus-circle fs-5"></i>
                        </button>
                      </div>
                    </td>
                    <td class="text-end">
                      <form action="/cart/delete-product/{{this.product._id}}/{{../user._id}}" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-2" title="Remove Item">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Order Summary Sidebar -->
        <div class="col-lg-4">
          <div class="cart-summary-box">
            <h5 class="fw-bold mb-3 text-dark">Order Summary</h5>
            
            <div class="d-flex justify-content-between mb-2 text-muted small">
              <span>Items Total:</span>
              <span class="fw-semibold text-dark">₹<span id="total">{{totalValue}}</span></span>
            </div>

            <div class="d-flex justify-content-between mb-2 text-muted small">
              <span>Estimated Shipping:</span>
              <span class="text-success fw-semibold">FREE</span>
            </div>

            <div class="d-flex justify-content-between mb-3 text-muted small">
              <span>Applicable Taxes:</span>
              <span class="text-muted">Included</span>
            </div>

            <hr>

            <div class="d-flex justify-content-between align-items-center mb-4">
              <span class="fw-bold fs-5 text-dark">Grand Total:</span>
              <span class="fw-extrabold fs-4 text-primary">₹{{totalValue}}</span>
            </div>

            <a href="/place-order" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
              <span>Proceed to Checkout</span>
              <i class="bi bi-arrow-right"></i>
            </a>

            <div class="mt-3 text-center">
              <small class="text-muted d-flex align-items-center justify-content-center gap-1">
                <i class="bi bi-shield-check text-success"></i> 100% Safe & Secure Checkout
              </small>
            </div>
          </div>
        </div>

      </div>

    {{/if}}

  </div>
</section>
