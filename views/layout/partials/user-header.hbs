<header>
  <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
    <div class="container">

      <!-- Brand Logo -->
      <a class="navbar-brand brand-logo" href="/">
        <i class="bi bi-bag-heart-fill"></i>
        <span>NexStore</span>
      </a>

      <!-- Mobile Toggle Button -->
      <button
        class="navbar-toggler border-0 shadow-none"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarMain"
        aria-controls="navbarMain"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <i class="bi bi-list fs-2 text-dark"></i>
      </button>

      <!-- Navbar Content -->
      <div class="collapse navbar-collapse" id="navbarMain">

        <!-- Nav Links -->
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="/">
              <i class="bi bi-grid me-1"></i> Explore Products
            </a>
          </li>

          {{#if user}}
          <li class="nav-item">
            <a class="nav-link" href="/all-orders">
              <i class="bi bi-box-seam me-1"></i> My Orders
            </a>
          </li>
          {{/if}}
        </ul>

        <!-- Right Side: Cart & Account -->
        <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
          
          <!-- Cart Button -->
          <a href="/cart" class="text-decoration-none">
            <button type="button" class="cart-btn-pill">
              <i class="bi bi-cart3"></i>
              <span>Cart</span>
              <span class="cart-badge-count" id="cartCount">{{#if cartCount}}{{cartCount}}{{else}}0{{/if}}</span>
            </button>
          </a>

          <!-- User Account Dropdown -->
          <div class="dropdown">
            <button
              class="user-profile-btn dropdown-toggle"
              type="button"
              id="userMenuButton"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              {{#if user}}
                <i class="bi bi-person-circle text-primary fs-5"></i>
                <span>{{user.name}}</span>
              {{else}}
                <i class="bi bi-person fs-5"></i>
                <span>Account</span>
              {{/if}}
            </button>

            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2 p-2" aria-labelledby="userMenuButton" style="min-width: 200px;">
              {{#if user}}
                <li class="px-3 py-2 border-bottom mb-1">
                  <div class="fw-bold text-dark">{{user.name}}</div>
                  <small class="text-muted text-truncate d-block">{{user.email}}</small>
                </li>
                <li>
                  <a class="dropdown-item rounded-2 py-2" href="/all-orders">
                    <i class="bi bi-box-seam me-2 text-primary"></i> My Orders
                  </a>
                </li>
                <li>
                  <a class="dropdown-item rounded-2 py-2" href="/cart">
                    <i class="bi bi-cart3 me-2 text-primary"></i> Shopping Cart
                  </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <a class="dropdown-item rounded-2 py-2 text-danger" href="/logout">
                    <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                  </a>
                </li>
              {{else}}
                <li>
                  <a class="dropdown-item rounded-2 py-2" href="/login">
                    <i class="bi bi-box-arrow-in-right me-2 text-primary"></i> Login
                  </a>
                </li>
                <li>
                  <a class="dropdown-item rounded-2 py-2" href="/signup">
                    <i class="bi bi-person-plus me-2 text-primary"></i> Create Account
                  </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <a class="dropdown-item rounded-2 py-2 text-muted" href="/admin/login">
                    <i class="bi bi-shield-lock me-2"></i> Admin Portal
                  </a>
                </li>
              {{/if}}
            </ul>
          </div>

        </div>

      </div>
    </div>
  </nav>
</header>
