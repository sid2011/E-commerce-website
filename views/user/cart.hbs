<section>
    <div class="container"><div class="row mt-3">
        <a href="/" class="btn btn-success ms-auto" style="width:11%">Go back</a></div>
        <table class="table mt-3">
  <thead>
    <tr>
        
      <th scope="col">No</th>
      <th scope="col">Title</th>
      <th scope="col">Category</th>
      <th scope="col">Price</th>
      <th scope="col">Quantity</th>
      <th scope="col">Description</th>
      <th>Image</th>
    </tr>
  </thead>
  <tbody>
    {{#each products}}
    <tr>
      <th scope="row">{{inc @index}}</th>
      <td>{{this.name}}</td>
      <td>{{this.category}}</td>
      <td>{{this.price}}</td>
      <td><button class="bg-danger">-</button> 1 <button class="bg-success">+</button></td>
      <td>{{this.description}}</td>
      <td><img style="width: 50px;height:50px"  src="../product-images/{{this._id}}.jpg" alt="{{this.name}}"></td>
    </tr>
    {{/each}}
  </tbody>
</table>
    </div>
</section>