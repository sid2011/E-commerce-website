<div class="container pb-5">
  
  <!-- ================= HERO SECTION ================= -->
  <section class="hero-banner">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <span class="hero-tag">
          <i class="bi bi-stars"></i> Curated Essentials & Best Tech Deals
        </span>
        <h1 class="hero-title">
          Next-Gen Tech & Premium Gear at Great Prices.
        </h1>
        <p class="hero-subtitle">
          Discover handpicked gadgets, cutting-edge accessories, and lifestyle essentials with fast shipping and seamless checkout.
        </p>
        <div class="d-flex flex-wrap gap-3">
          <a href="#product-showcase" class="hero-cta">
            <span>Explore Collection</span>
            <i class="bi bi-arrow-right"></i>
          </a>
          {{#if user}}
          <a href="/all-orders" class="btn btn-outline-light rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2 fw-semibold">
            <i class="bi bi-box-seam"></i> Track Orders
          </a>
          {{/if}}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SEARCH & CATEGORY BAR ================= -->
  <section id="product-showcase" class="mt-5 pt-3">
    <div class="row align-items-center justify-content-between g-3 mb-4">
      
      <!-- Section Title -->
      <div class="col-md-4">
        <h2 class="fw-bold fs-3 mb-1 text-dark">Our Catalog</h2>
        <p class="text-muted small mb-0">Browse through our quality curated products</p>
      </div>

      <!-- Live Search Box -->
      <div class="col-md-5 col-lg-4">
        <div class="search-input-group">
          <i class="bi bi-search"></i>
          <input
            type="text"
            id="productSearchInput"
            class="form-control"
            placeholder="Search by product name or category..."
            onkeyup="filterProducts()"
          />
        </div>
      </div>

    </div>

    <!-- Category Filter Pills -->
    <div class="category-filter-wrap mb-4">
      <button class="cat-pill active" onclick="filterByCategory('all', this)">
        <i class="bi bi-grid-fill me-1"></i> All Products
      </button>
      <button class="cat-pill" onclick="filterByCategory('mobile', this)">Smartphones</button>
      <button class="cat-pill" onclick="filterByCategory('laptop', this)">Laptops</button>
      <button class="cat-pill" onclick="filterByCategory('audio', this)">Audio & Headphones</button>
      <button class="cat-pill" onclick="filterByCategory('watch', this)">Smartwatches</button>
      <button class="cat-pill" onclick="filterByCategory('electronics', this)">Electronics</button>
    </div>

    <!-- ================= PRODUCTS GRID ================= -->
    <div class="row g-4" id="productsGrid">
      {{#if products.length}}
        {{#each products}}
        <div class="col-12 col-sm-6 col-lg-3 product-item" data-category="{{this.category}}" data-name="{{this.name}}">
          <div class="product-card">
            
            <!-- Image Wrapper -->
            <div class="product-img-wrapper">
              <img
                src="/product-images/{{this._id}}.jpg"
                alt="{{this.name}}"
                onerror="this.onerror=null; this.src='https://placehold.co/400x400/e2e8f0/475569?text=NexStore';"
              />
            </div>

            <!-- Card Details -->
            <div class="product-card-body">
              {{#if this.category}}
                <span class="product-category-tag">{{this.category}}</span>
              {{else}}
                <span class="product-category-tag">Featured</span>
              {{/if}}

              <h3 class="product-title" title="{{this.name}}">{{this.name}}</h3>
              <p class="product-desc" title="{{this.description}}">{{this.description}}</p>

              <!-- Price & Add-to-Cart -->
              <div class="product-price-row">
                <div class="product-price">
                  <span>₹</span>{{this.price}}
                </div>
                
                <button
                  type="button"
                  onclick="addToCart('{{this._id}}')"
                  class="btn-add-cart"
                  id="btn-{{this._id}}"
                >
                  <i class="bi bi-cart-plus"></i>
                  <span>Add</span>
                </button>
              </div>

            </div>

          </div>
        </div>
        {{/each}}
      {{else}}
        <!-- Empty State -->
        <div class="col-12 text-center py-5">
          <div class="py-5">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <h4 class="mt-3 fw-bold">No Products Available</h4>
            <p class="text-muted">Check back soon as we restock new arrivals!</p>
          </div>
        </div>
      {{/if}}
    </div>

    <!-- No Search Results Found Element -->
    <div id="noResultsMessage" class="text-center py-5 d-none">
      <i class="bi bi-search fs-1 text-muted"></i>
      <h4 class="mt-3 fw-bold">No Matching Products</h4>
      <p class="text-muted">Try searching with a different keyword or category.</p>
    </div>

  </section>

  <!-- ================= VALUE PROPOSITIONS / FEATURES ================= -->
  <section class="mt-5 pt-4">
    <div class="row g-3">
      <div class="col-12 col-md-3">
        <div class="feature-box">
          <div class="feature-icon-circle">
            <i class="bi bi-truck"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-1">Fast Delivery</h6>
            <small class="text-muted">Swift & secure shipping</small>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-3">
        <div class="feature-box">
          <div class="feature-icon-circle">
            <i class="bi bi-shield-check"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-1">Secure Payments</h6>
            <small class="text-muted">100% protected transactions</small>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-3">
        <div class="feature-box">
          <div class="feature-icon-circle">
            <i class="bi bi-arrow-repeat"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-1">Easy Returns</h6>
            <small class="text-muted">Hassle-free 7-day policy</small>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-3">
        <div class="feature-box">
          <div class="feature-icon-circle">
            <i class="bi bi-headset"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-1">24/7 Support</h6>
            <small class="text-muted">Ready to assist anytime</small>
          </div>
        </div>
      </div>
    </div>
  </section>

</div>

<!-- ================= MODERN FOOTER ================= -->
<footer class="footer-custom">
  <div class="container">
    <div class="row gy-4">
      <div class="col-lg-4 col-md-6">
        <a class="navbar-brand brand-logo mb-2 d-inline-block" href="/">
          <i class="bi bi-bag-heart-fill"></i>
          <span>NexStore</span>
        </a>
        <p class="text-muted small mt-2 pe-lg-4">
          NexStore brings you high quality modern gadgets and electronics at competitive prices with state-of-the-art security and reliable customer satisfaction.
        </p>
      </div>

      <div class="col-lg-2 col-md-6 col-6">
        <h6 class="fw-bold mb-3 text-dark">Quick Links</h6>
        <ul class="list-unstyled small d-flex flex-column gap-2">
          <li><a href="/" class="text-muted text-decoration-none">Catalog</a></li>
          <li><a href="/cart" class="text-muted text-decoration-none">Cart</a></li>
          <li><a href="/all-orders" class="text-muted text-decoration-none">My Orders</a></li>
        </ul>
      </div>

      <div class="col-lg-2 col-md-6 col-6">
        <h6 class="fw-bold mb-3 text-dark">Customer Care</h6>
        <ul class="list-unstyled small d-flex flex-column gap-2">
          <li><a href="#" class="text-muted text-decoration-none">Shipping Policy</a></li>
          <li><a href="#" class="text-muted text-decoration-none">Return Policy</a></li>
          <li><a href="#" class="text-muted text-decoration-none">Privacy Terms</a></li>
        </ul>
      </div>

      <div class="col-lg-4 col-md-6">
        <h6 class="fw-bold mb-3 text-dark">Payment Methods</h6>
        <p class="text-muted small mb-3">We support Cash on Delivery, UPI, Cards, and Net Banking via Razorpay.</p>
        <div class="d-flex gap-2 fs-4 text-muted">
          <i class="bi bi-credit-card-2-front"></i>
          <i class="bi bi-wallet2"></i>
          <i class="bi bi-shield-lock"></i>
        </div>
      </div>
    </div>

    <div class="border-top mt-4 pt-3 d-flex flex-wrap justify-content-between align-items-center small text-muted">
      <span>&copy; 2026 NexStore Inc. All rights reserved.</span>
      <span>Designed with modern e-commerce standards</span>
    </div>
  </div>
</footer>

<!-- Client-side Interactive Filter Script -->
<script>
let currentCategory = 'all';

function filterByCategory(cat, btn) {
  currentCategory = cat.toLowerCase();
  document.querySelectorAll('.cat-pill').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  applyFilters();
}

function filterProducts() {
  applyFilters();
}

function applyFilters() {
  const searchTerm = (document.getElementById('productSearchInput')?.value || '').toLowerCase().trim();
  const items = document.querySelectorAll('.product-item');
  let visibleCount = 0;

  items.forEach(item => {
    const name = (item.getAttribute('data-name') || '').toLowerCase();
    const category = (item.getAttribute('data-category') || '').toLowerCase();

    const matchesCategory = (currentCategory === 'all') || category.includes(currentCategory);
    const matchesSearch = !searchTerm || name.includes(searchTerm) || category.includes(searchTerm);

    if (matchesCategory && matchesSearch) {
      item.style.display = 'block';
      visibleCount++;
    } else {
      item.style.display = 'none';
    }
  });

  const noResults = document.getElementById('noResultsMessage');
  if (noResults) {
    if (visibleCount === 0 && items.length > 0) {
      noResults.classList.remove('d-none');
    } else {
      noResults.classList.add('d-none');
    }
  }
}
</script>
