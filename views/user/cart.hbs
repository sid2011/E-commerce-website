<section>
    <div class="container"><div class="row mt-3">
        <a href="/" class="btn btn-success ms-auto" style="width:11%">Go back</a></div>
        <table class="table mt-3">
  <thead>
    <tr>
        
      <th scope="col">No</th>
      <th scope="col">Title</th>
      <th scope="col">Category</th>
      <th scope="col">Price</th>
      <th scope="col">Quantity</th>
      <th scope="col">Description</th>
      <th>Image</th>
    </tr>
  </thead>
  <tbody>
    {{#each products}}
<tr>
  {{#each this.product}}
  <th scope="row">{{inc @index}}</th>
  <td>{{this.name}}</td>
  <td>
    <img
      style="width:50px;height:50px"
      src="/product-images/{{this._id}}.jpg"
      alt="{{this.name}}"
    >
  </td>
  <td>{{this.category}}</td>
  <td>{{this.price}}</td>
  <td>
    <button class="bg-danger">-</button>
    {{../quantity}}
    <button class="bg-success">+</button>
  </td>
  <td>{{this.description}}</td>
  <td>
    <a
      href="/cart/delete-product/{{this._id}}"
      class="btn btn-danger"
      onclick="return confirm('Do you want to delete {{this.name}}??')"
    >
      Delete
    </a>
  </td>
  {{/each}}
</tr>
{{/each}}
  </tbody>
</table>
    </div>
</section>