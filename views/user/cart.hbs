<section>
    <div class="container">

        <div class="row mt-3">
            <a href="/" class="btn btn-success ms-auto" style="width:11%">
                Go back
            </a>
        </div>

        <table class="table mt-3">

            <thead>
                <tr>
                    <th>No</th>
                    <th>Title</th>
                    <th>Image</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Description</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                {{#each products}}

                <tr>

                    <th scope="row">{{inc @index}}</th>

                    <td>{{this.product.name}}</td>

                    <td>
                        <img
                            style="width:50px;height:50px"
                            src="/product-images/{{this.product._id}}.jpg"
                            alt=""
                        >
                    </td>

                    <td>{{this.product.category}}</td>

                    <td>{{this.product.price}}</td>

                    <td>

                        <button
                            class="bg-danger"
                            onclick="changeQuantity('{{this._id}}','{{this.product._id}}',-1)"
                        >
                            -
                        </button>

                        <span id="{{this.product._id}}">
                            {{this.quantity}}
                        </span>

                        <button
                            class="bg-success"
                            onclick="changeQuantity('{{this._id}}','{{this.product._id}}',1)"
                        >+
                        </button>

                    </td>

                    <td>{{this.product.description}}</td>
<td>
                    <form action="/cart/delete-product/{{this.product._id}}/{{../user._id}}" method="post">
    <button type="submit" class="btn btn-danger">
        Delete
    </button>
</form>
</td>
                </tr>

                {{/each}}

            </tbody>

        </table>

    </div>
</section>