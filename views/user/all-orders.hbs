<section class="py-4">
  <div class="container">

    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h2 class="fw-bold mb-1">My Purchase History</h2>
        <p class="text-muted small mb-0">Check the status of your past and ongoing orders</p>
      </div>

      <a href="/" class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Continue Shopping
      </a>
    </div>

    <div class="modern-table-card">
      <div class="table-responsive">
        <table class="table modern-table">
          <thead>
            <tr>
              <th scope="col" style="width: 60px;">#</th>
              <th scope="col">Order Date</th>
              <th scope="col">Delivery Address</th>
              <th scope="col">PIN Code</th>
              <th scope="col">Total Paid</th>
              <th scope="col">Payment Mode</th>
              <th scope="col" class="text-end">Status</th>
            </tr>
          </thead>
          <tbody>
            {{#if orderlist.length}}
              {{#each orderlist}}
              <tr>
                <td class="fw-semibold text-muted">{{inc @index}}</td>
                <td class="small text-muted">{{formatDate this.date}}</td>
                <td class="small text-dark" style="max-width: 250px;">{{this.address}}</td>
                <td><span class="badge bg-light text-dark border">{{this.pincode}}</span></td>
                <td><span class="fw-bold text-dark fs-6">₹{{this.total}}</span></td>
                <td><span class="badge bg-light text-primary border">{{this.paymentMethod}}</span></td>
                <td class="text-end">
                  {{#if (eq this.status 'placed')}}
                    <span class="status-badge placed">
                      <i class="bi bi-check2-circle"></i> Placed
                    </span>
                  {{else}}
                    <span class="status-badge pending">
                      <i class="bi bi-clock-history"></i> {{this.status}}
                    </span>
                  {{/if}}
                </td>
              </tr>
              {{/each}}
            {{else}}
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <i class="bi bi-bag-x fs-1 d-block mb-2"></i>
                  You haven't placed any orders yet.
                </td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>
