<section class="py-4">
  <div class="container">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
      <div>
        <h2 class="fw-bold mb-1">Customer Orders</h2>
        <p class="text-muted small mb-0">Track and manage placed customer purchases</p>
      </div>

      <a href="/admin" class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
      </a>
    </div>

    <div class="modern-table-card">
      <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-bag-check-fill text-success fs-5"></i>
          <h5 class="fw-bold mb-0">All Orders</h5>
          <span class="badge bg-light text-dark border ms-2">{{totalOrders}} Orders</span>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table modern-table">
          <thead>
            <tr>
              <th scope="col" style="width: 50px;">#</th>
              <th scope="col">Customer</th>
              <th scope="col">Shipping Details</th>
              <th scope="col">Total Amount</th>
              <th scope="col">Payment Method</th>
              <th scope="col">Order Date</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {{#if orderlist.length}}
              {{#each orderlist}}
              <tr>
                <td class="fw-semibold text-muted">{{inc @index}}</td>
                <td>
                  <div class="fw-bold text-dark">{{this.userName}}</div>
                  <small class="text-muted">{{this.userEmail}}</small>
                </td>
                <td>
                  <div class="small text-dark">{{this.deliveryDetails.address}}</div>
                  <small class="text-muted">Pin: {{this.deliveryDetails.pincode}} | Ph: {{this.deliveryDetails.mobile}}</small>
                </td>
                <td>
                  <span class="fw-bold text-dark fs-6">₹{{this.totalAmount}}</span>
                </td>
                <td>
                  <span class="badge bg-light text-dark border">
                    {{this.paymentMethod}}
                  </span>
                </td>
                <td class="small text-muted">
                  {{formatDate this.date}}
                </td>
                <td>
                  {{#if (eq this.status 'placed')}}
                    <span class="status-badge placed">
                      <i class="bi bi-check2-circle"></i> Placed
                    </span>
                  {{else}}
                    <span class="status-badge pending">
                      <i class="bi bi-clock-history"></i> {{this.status}}
                    </span>
                  {{/if}}
                </td>
              </tr>
              {{/each}}
            {{else}}
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <i class="bi bi-box2 fs-1 d-block mb-2"></i>
                  No orders have been placed yet.
                </td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>
